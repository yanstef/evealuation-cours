# Base Postgres (Neon via Vercel Marketplace : injecté automatiquement)
DATABASE_URL=

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optionnel : modèle de correction (défaut : claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mot de passe de l'espace enseignant
ADMIN_PASSWORD=

# Secret de signature des cookies (chaîne aléatoire de 32+ caractères)
SESSION_SECRET=
